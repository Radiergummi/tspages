{{define "title"}} - {{.SiteName}} submissions{{end}}
{{define "head-extra"}}{{end}}

{{define "sort-icon"}}{{/* expects SortState */}}
{{if .Desc}}
    <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
    >
        <path d="m3 8 4-4 4 4" />
        <path d="M7 4v16" />
        <path d="M11 12h10" />
        <path d="M11 16h7" />
        <path d="M11 20h4" />
    </svg>
    {{with .Position}}
        <span class="text-[10px] font-bold leading-none">
            {{.}}
        </span>
    {{end}}
{{else if .Asc}}
    <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
    >
        <path d="m3 16 4 4 4-4" />
        <path d="M7 20V4" />
        <path d="M11 4h4" />
        <path d="M11 8h7" />
        <path d="M11 12h10" />
    </svg>
    {{with .Position}}
        <span class="text-[10px] font-bold leading-none">
            {{.}}
        </span>
    {{end}}
{{else}}
    <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-0 group-hover/thead:opacity-50 transition-opacity"
    >
        <path d="m21 16-4 4-4-4" />
        <path d="M17 20V4" />
        <path d="m3 8 4-4 4 4" />
        <path d="M7 4v16" />
    </svg>
{{end}}
{{end}}

{{define "content"}}
    <article class="flex flex-col gap-8">
        <nav>
            <a
                    class="inline-flex items-center gap-2 text-sm text-muted no-underline hover:text-black
                    dark:hover:text-base-200"
                    href="/sites/{{.SiteName}}"
            >
                <svg
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                >
                    <path d="M9 14 4 9l5-5" />
                    <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" />
                </svg>
                <span>
                    {{.SiteName}}
                </span>
            </a>
        </nav>

        <header class="flex items-center justify-between">
            <h1 class="text-2xl font-semibold tracking-tight">
                Submissions
            </h1>
        </header>

        {{if .Paths}}
            <!-- region Analytics -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <section
                        class="col-span-1 sm:col-span-2 bg-surface dark:ring-1 dark:ring-base-500/25
                        rounded-md overflow-hidden m-0"
                >
                    <header class="flex items-end justify-end gap-10 px-5 h-14">
                        <div class="flex flex-col">
                            <span class="text-[0.5rem] uppercase tracking-widest text-muted font-medium">
                                Submissions
                            </span>
                            <code class="font-mono text-2xl font-semibold tracking-tight leading-tight">
                                {{fmtnum .TotalCount}}
                            </code>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[0.5rem] uppercase tracking-widest text-muted font-medium">
                                Submitters
                            </span>
                            <code class="font-mono text-2xl font-semibold tracking-tight leading-tight">
                                {{fmtnum .Submitters}}
                            </code>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[0.5rem] uppercase tracking-widest text-muted font-medium">
                                Forms
                            </span>
                            <code class="font-mono text-2xl font-semibold tracking-tight leading-tight">
                                {{len .Paths}}
                            </code>
                        </div>
                    </header>

                    {{if .TimeSeriesByForm}}
                        <div class="relative pt-4">
                            <canvas
                                    id="submissions-chart"
                                    height="180"
                                    aria-label="Submissions over time"
                                    role="img"
                            ></canvas>
                        </div>
                    {{end}}
                </section>

                {{if and .FormPaths (gt (len .FormPaths) 1)}}
                    <section
                            class="bg-surface dark:ring-1
                            dark:ring-base-500/25 rounded-md overflow-hidden m-0"
                    >
                        <header class="flex items-center justify-between px-5 h-14">
                            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted m-0">
                                By form
                            </h2>
                        </header>
                        <div class="relative px-4 pb-3 h-48">
                            <canvas
                                    id="forms-chart"
                                    aria-label="Submissions by form"
                                    role="img"
                            ></canvas>
                        </div>
                    </section>
                {{end}}

            </div>
            <!-- endregion -->
            <!-- region Forms Navigation -->
            {{if (gt (len .Paths) 1)}}
                <nav aria-label="Form paths" class="flex flex-wrap gap-1">
                    {{range .Paths}}
                        <a
                                class="pill inline-flex items-center gap-2 pe-1.5 group"
                                href="/sites/{{$.SiteName}}/submissions?path={{.Path}}"
                                {{if eq .Path $.CurrentPath}}aria-current="step"{{end}}
                        >
                            <span>{{.Name}}</span>
                            <span
                                    class="text-muted dark:text-base-100 bg-base-100 dark:bg-base-800/75
                                    dark:group-hover:bg-base-800 group-aria-[current=step]:bg-blue-300/75
                                    group-aria-[current=step]:text-paper dark:group-aria-[current=step]:bg-blue-700
                                    group-hover:bg-base-200 rounded-full flex items-center justify-center p-1 min-w-6
                                    transition"
                            >
                                {{.Count}}
                            </span>
                        </a>
                    {{end}}
                </nav>
            {{end}}
            <!-- endregion -->

            {{if .Submissions}}
                <div class="grid grid-cols-[1fr_auto] grid-rows-2">
                    {{if .FormName}}
                        <h2 class="text-lg font-semibold">
                            {{.FormName}}
                        </h2>

                        {{if .FormDesc}}
                            <p class="text-sm text-muted row-start-2">
                                {{.FormDesc}}
                            </p>
                        {{else}}
                            <span class="text-sm text-muted row-start-2">
                                {{.CurrentPath}}
                            </span>
                        {{end}}
                    {{else}}
                        <span></span>
                    {{end}}

                    <!-- region Actions -->
                    <div class="flex items-center gap-2 row-span-2">
                        {{if .VAPIDKey}}
                            <button
                                    id="notify-btn"
                                    class="btn btn-outline inline-flex items-center gap-1.5"
                                    data-site="{{.SiteName}}"
                                    data-path="{{.CurrentPath}}"
                                    data-vapid="{{.VAPIDKey}}"
                                    hidden
                            >
                                <svg
                                        aria-hidden="true"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                >
                                    <path d="M10.268 21a2 2 0 0 0 3.464 0" />
                                    <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" />
                                </svg>
                                <span id="notify-label">Notify me</span>
                            </button>
                        {{end}}
                        <a
                                class="btn btn-outline inline-flex items-center gap-1.5 no-underline"
                                href="/sites/{{.SiteName}}/submissions/export?path={{.CurrentPath}}&format=csv"
                        >
                            <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                            >
                                <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
                                <path d="M12 22V12" />
                                <polyline points="3.29 7 12 12 20.71 7" />
                                <path d="m7.5 4.27 9 5.15" />
                            </svg>

                            <span>Export CSV</span>
                        </a>
                        {{if .Admin}}
                            <form
                                    method="POST"
                                    action="/sites/{{.SiteName}}/submissions/delete"
                                    onsubmit="return confirm('Delete all submissions for this form?')"
                            >
                                <input type="hidden" name="path" value="{{.CurrentPath}}">
                                <button type="submit" class="btn btn-danger">Delete all</button>
                            </form>
                        {{end}}
                    </div>
                    <!-- endregion -->
                </div>

                <!-- region Overflow actions -->
                {{if gt .TotalCount .PageSize}}
                    <p class="text-sm text-muted">
                        Showing {{.PageSize}} of {{.TotalCount}} submissions.
                        <a
                                href="/sites/{{.SiteName}}/submissions/export?path={{.CurrentPath}}&format=csv"
                                class="text-blue-500 no-underline hover:underline"
                        >
                            Export all
                        </a>
                    </p>
                {{end}}
                <!-- endregion -->

                <div class="overflow-x-auto">
                    <table class="w-full border-collapse rounded-md overflow-hidden text-sm">

                        <!-- region Table Head -->
                        <thead class="group/thead">
                        <tr>
                            <th
                                    scope="col"
                                    class="text-start ps-8 pe-4 py-3 text-xs uppercase tracking-wider text-muted
                                    font-medium border-b-2 border-default whitespace-nowrap"
                            >
                                <a
                                        class="no-underline text-inherit hover:text-black dark:hover:text-base-200
                                        transition"
                                        href="{{$.SortHref "submitter"}}"
                                >
                                    <span class="inline-flex items-center gap-1">
                                        <span>Submitted by</span>
                                        {{template "sort-icon" ($.SortInfo "submitter")}}
                                    </span>
                                </a>
                            </th>
                            <th
                                    scope="col"
                                    class="text-start pe-4 py-3 text-xs uppercase tracking-wider text-muted font-medium
                                    border-b-2 border-default whitespace-nowrap"
                            >
                                <a
                                        class="no-underline text-inherit hover:text-black dark:hover:text-base-200
                                        transition"
                                        href="{{$.SortHref "date"}}"
                                >
                                    <span class="inline-flex items-center gap-1">
                                        <span>Date</span>
                                        {{template "sort-icon" ($.SortInfo "date")}}
                                    </span>
                                </a>
                            </th>
                            {{range .FieldKeys}}
                                <th
                                        scope="col"
                                        class="text-start data-numeric:text-end pe-4 last:pe-0 py-3 text-xs uppercase
                                        tracking-wider text-muted font-medium border-b-2 border-default
                                        whitespace-nowrap"
                                        {{if index $.NumericFields .}}data-numeric="true"{{end}}
                                >
                                    <a
                                            class="no-underline text-inherit hover:text-black
                                            dark:hover:text-base-200 transition"
                                            href="{{$.SortHref .}}"
                                    >
                                        <span class="inline-flex items-center gap-1">
                                            <span>{{index $.FieldLabels .}}</span>
                                            {{template "sort-icon" ($.SortInfo .)}}
                                        </span>
                                    </a>
                                </th>
                            {{end}}
                            <th scope="col" class="w-10 py-3 border-b-2 border-default">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                        </thead>
                        <!-- endregion -->

                        <!-- region Table Body -->
                        <tbody class="[&>tr:last-child>td]:border-b-0">
                        {{range $sub := .Submissions}}
                            <tr>
                                <td class="pe-4 py-3 border-b border-default whitespace-nowrap">
                                    <span class="inline-flex items-center gap-2">
                                        {{avatarHTML $sub.DisplayName $sub.SubmitterPicURL}}
                                        {{$sub.DisplayName}}
                                    </span>
                                </td>

                                <td class="pe-4 py-3 border-b border-default whitespace-nowrap text-muted">
                                    <time datetime="{{abstime $sub.CreatedAt}}" title="{{abstime $sub.CreatedAt}}">
                                        {{reltime $sub.CreatedAt}}
                                    </time>
                                </td>

                                {{range $key := $.FieldKeys}}
                                    <td
                                            class="pe-4 last:pe-0 py-3 border-b border-default max-w-64
                                            data-numeric:text-end data-numeric:tabular-nums"
                                            {{if index $.NumericFields $key}}data-numeric="true"{{end}}
                                    >
                                        {{with index $sub.ParsedFields $key}}
                                            <span
                                                    class="whitespace-pre-wrap wrap-break-word line-clamp-3"
                                                    title="{{.}}"
                                            >{{.}}</span>
                                        {{else}}
                                            <span class="text-muted italic">—</span>
                                        {{end}}
                                    </td>
                                {{end}}
                                <td class="py-3 border-b border-default text-end">
                                    <!-- region Actions toggle button -->
                                    <button
                                            class="btn-icon"
                                            popovertarget="actions-{{$sub.ID}}"
                                            aria-label="Actions"
                                            style="anchor-name: --a{{$sub.ID}}"
                                    >
                                        <svg
                                                aria-hidden="true"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="16"
                                                height="16"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                        >
                                            <circle cx="12" cy="12" r="1" />
                                            <circle cx="12" cy="5" r="1" />
                                            <circle cx="12" cy="19" r="1" />
                                        </svg>
                                    </button>
                                    <!-- endregion -->

                                    <!-- region Actions menu popover -->
                                    <div
                                            popover="auto"
                                            id="actions-{{$sub.ID}}"
                                            class="popover-menu"
                                            style="position-anchor: --a{{$sub.ID}}"
                                    >
                                        <button type="button" popovertarget="detail-{{$sub.ID}}">
                                            <svg
                                                    aria-hidden="true"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                            >
                                                <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                            <span>
                                                View details
                                            </span>
                                        </button>

                                        {{if $.Admin}}
                                            <form
                                                    method="POST"
                                                    action="/sites/{{$.SiteName}}/submissions/{{$sub.ID}}/delete"
                                                    onsubmit="return confirm('Delete this submission?')"
                                            >
                                                <input type="hidden" name="path" value="{{$.CurrentPath}}">
                                                <button type="submit" class="menu-danger">
                                                    <svg
                                                            aria-hidden="true"
                                                            xmlns="http://www.w3.org/2000/svg"
                                                            width="16"
                                                            height="16"
                                                            viewBox="0 0 24 24"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            stroke-width="2"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                    >
                                                        <path d="M3 6h18" />
                                                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                    </svg>

                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        {{end}}
                                    </div>
                                    <!-- endregion -->

                                    <!-- region Detail popover -->
                                    <article popover="auto" id="detail-{{$sub.ID}}" class="popover-detail">
                                        <header
                                                class="flex items-center justify-between px-5 py-4 border-b
                                                border-default"
                                        >
                                            <h3 class="text-base font-semibold">
                                                Submission details
                                            </h3>
                                            <button
                                                    class="btn-icon"
                                                    popovertarget="detail-{{$sub.ID}}"
                                                    popovertargetaction="hide"
                                                    aria-label="Close"
                                            >
                                                <svg
                                                        aria-hidden="true"
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                >
                                                    <path d="M18 6 6 18" />
                                                    <path d="m6 6 12 12" />
                                                </svg>
                                            </button>
                                        </header>

                                        <dl class="px-5 py-4 flex flex-col gap-1 text-sm text-start">
                                            <dt class="text-muted font-medium">
                                                Submitted by
                                            </dt>
                                            <dd class="inline-flex items-center gap-2">
                                                {{avatarHTML $sub.DisplayName $sub.SubmitterPicURL}}
                                                {{$sub.DisplayName}}
                                            </dd>

                                            {{if $sub.SubmitterName}}
                                                <dd class="text-muted">
                                                    {{$sub.Submitter}}
                                                </dd>
                                            {{end}}

                                            <dt class="text-muted font-medium mt-4">
                                                Date
                                            </dt>
                                            <dd class="tabular-nums">
                                                <time
                                                        datetime="{{abstime $sub.CreatedAt}}"
                                                        title="{{abstime $sub.CreatedAt}}"
                                                >
                                                    {{reltime $sub.CreatedAt}}
                                                </time>
                                            </dd>

                                            <dt class="text-muted font-medium mt-4">
                                                Node
                                            </dt>
                                            <dd>
                                                <code>{{$sub.Node}}</code>
                                            </dd>

                                            <dt class="text-muted font-medium mt-4">
                                                IP address
                                            </dt>
                                            <dd>
                                                <code>{{$sub.IP}}</code>
                                            </dd>

                                            {{range $key := $.FieldKeys}}
                                                <dt class="text-muted font-medium mt-4">
                                                    {{index $.FieldLabels $key}}
                                                </dt>
                                                <dd>
                                                    {{with index $sub.ParsedFields $key}}
                                                        <span
                                                                class="whitespace-pre-wrap wrap-break-word"
                                                        >{{.}}</span>
                                                    {{else}}
                                                        <span class="text-muted italic">—</span>
                                                    {{end}}
                                                </dd>
                                            {{end}}
                                        </dl>
                                    </article>
                                    <!-- endregion -->
                                </td>
                            </tr>
                        {{end}}
                        </tbody>
                        <!-- endregion -->

                        <!-- region Summary Footer -->
                        {{if .HasSummary}}
                            <tfoot>
                            <tr class="border-t-2 border-default">
                                <td
                                        class="ps-8 pe-4 py-3 text-xs font-medium text-muted uppercase tracking-wider
                                        whitespace-nowrap"
                                >
                                    {{len .Submissions}} of {{.TotalCount}}
                                </td>

                                <td class="pe-4 py-3 text-xs text-muted whitespace-nowrap">
                                    {{.DateSummary}}
                                </td>

                                {{range .FieldKeys}}
                                    <td
                                            class="pe-4 last:pe-0 py-3 text-xs text-muted data-numeric:text-end
                                            data-numeric:tabular-nums"
                                            {{if index $.NumericFields .}}data-numeric="true"{{end}}
                                    >
                                        {{index $.Summary .}}
                                    </td>
                                {{end}}
                                <td></td>
                            </tr>
                            </tfoot>
                        {{end}}
                        <!-- endregion -->
                    </table>
                </div>
            {{else}}
                <!-- region No submissions -->
                <p class="text-center py-12 px-8 text-muted text-sm border border-default rounded-md bg-surface">
                    No submissions for this form.
                </p>
                <!-- endregion -->
            {{end}}
        {{else}}
            <!-- region No forms -->
            <p class="text-center py-12 px-8 text-muted text-sm border border-default rounded-md bg-surface">
                No forms yet.
            </p>
            <!-- endregion -->
        {{end}}
    </article>
{{end}}

{{define "script"}}
    <script type="module" src="{{asset "pages/submissions.ts"}}"></script>
{{end}}
