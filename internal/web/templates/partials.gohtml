{{define "pagination"}}
{{if .Visible}}
<nav aria-label="Pagination" class="grid grid-cols-3 items-center mt-4">
    <div>
        {{if .HasPrev}}
            <a class="btn btn-ghost inline-flex items-center gap-2 no-underline" href="{{.PrevURL}}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                <span>Newer</span>
            </a>
        {{end}}
    </div>
    <span class="text-muted text-sm text-center">Page {{.Page}} of {{.TotalPages}}</span>
    <div class="place-self-end">
        {{if .HasNext}}
            <a class="btn btn-ghost inline-flex items-center gap-2 no-underline" href="{{.NextURL}}">
                <span>Older</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
        {{end}}
    </div>
</nav>
{{end}}
{{end}}
