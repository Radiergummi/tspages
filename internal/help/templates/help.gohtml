{{define "title"}} - {{.Current.Title}}{{end}}

{{define "main-attrs"}}style="max-width:80rem"{{end}}

{{define "content"}}
    <div class="xl:grid xl:grid-cols-[12rem_minmax(0,1fr)_11rem] xl:gap-8 xl:justify-center">
        <nav aria-label="Help topics" class="mb-6 xl:mb-0 xl:sticky xl:top-21 xl:self-start">
            {{range $i, $group := .Nav}}
                <h2 class="hidden xl:block text-xs font-semibold text-muted uppercase tracking-wider px-3 mb-1 {{if $i}}mt-4{{end}}">
                    {{$group.Label}}
                </h2>
                <ul class="flex flex-wrap gap-1 xl:flex-col xl:gap-0.5">
                    {{range $group.Pages}}
                        <li>
                            <a
                                    href="/help/{{.Slug}}"
                                    {{if eq .Slug $.Current.Slug}}aria-current="page"{{end}}
                                    class="block px-3 py-1.5 rounded-md text-sm no-underline transition-colors
                              {{if eq .Slug $.Current.Slug}}bg-blue-500/10 text-blue-500 font-medium
                              {{else}}text-muted hover:text-black dark:hover:text-base-200{{end}}"
                            >
                                {{.Title}}
                            </a>
                        </li>
                    {{end}}
                </ul>
            {{end}}
        </nav>

        <article class="min-w-0 prose">
            <header class="mb-6">
                <div class="flex items-center gap-2 mb-1">
                    <h1 class="text-2xl font-semibold">{{.Current.Title}}</h1>
                    {{if .Meta.Category}}
                        <span class="px-2 py-0.5 text-xs font-medium rounded-full
                            {{if eq .Meta.Category "guide"}}bg-green-600/10 text-green-600 dark:bg-green-300/10 dark:text-green-300
                            {{else}}bg-blue-600/10 text-blue-600 dark:bg-blue-300/10 dark:text-blue-300{{end}}">
                            {{.Meta.Category}}
                        </span>
                    {{end}}
                </div>
                {{if or .Meta.Description .Meta.Updated}}
                    <div class="flex flex-wrap items-baseline gap-x-3 text-sm text-muted">
                        {{if .Meta.Description}}
                            <p>{{.Meta.Description}}</p>
                        {{end}}
                        {{if .Meta.Updated}}
                            <time class="text-xs">Updated {{.Meta.Updated}}</time>
                        {{end}}
                    </div>
                {{end}}
            </header>
            {{.Content}}
        </article>

        {{if ge (len .TOC) 3}}
            <nav aria-label="On this page" class="hidden xl:block xl:sticky xl:top-21 xl:self-start">
                <h2 class="text-xs font-semibold text-muted uppercase tracking-wider mb-3">On this page</h2>
                <ul class="flex flex-col gap-0.5 text-sm">
                    {{range .TOC}}
                        <li>
                            <a
                                    href="#{{.ID}}"
                                    data-toc-link
                                    class="block py-0.5 no-underline transition-colors text-muted hover:text-black dark:hover:text-base-200
                                        aria-[current=true]:text-blue-500 aria-[current=true]:font-medium
                                        {{if eq .Level 3}}pl-3{{end}}"
                            >
                                {{.Text}}
                            </a>
                        </li>
                    {{end}}
                </ul>
            </nav>
        {{end}}
    </div>
{{end}}

{{define "script"}}
    <script type="module" src="{{asset "pages/help.ts"}}"></script>
{{end}}
